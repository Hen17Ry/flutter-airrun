{
  "name": "flutter-airrun-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "Flutter AirRun monorepo",
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm -r --if-present run check",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "clean": "pnpm -r --if-present run clean",
    "cli:check": "pnpm --filter @flutter-airrun/cli check",
    "cli:build": "pnpm --filter @flutter-airrun/cli build",
    "cli": "pnpm --filter @flutter-airrun/cli start --"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@vscode/vsce-sign",
      "keytar"
    ]
  }
}
