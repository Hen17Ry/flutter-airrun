{
  "name": "@flutter-airrun/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "airrun": "dist/airrun.cjs"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm --filter @flutter-airrun/core build && node esbuild.mjs",
    "start": "node dist/airrun.cjs",
    "build:executables": "pnpm run build && node scripts/build-executables.mjs"
  },
  "dependencies": {
    "@flutter-airrun/core": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
