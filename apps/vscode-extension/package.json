{
  "name": "flutter-airrun",
  "displayName": "Flutter AirRun",
  "description": "Pair, connect and run Flutter apps wirelessly on Android from VS Code or the interactive AirRun CLI.",
  "version": "0.1.0",
  "publisher": "flutter-airrun",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "flutter",
    "dart",
    "android",
    "adb",
    "wireless-debugging",
    "wireless",
    "vscode",
    "cli",
    "qr-code",
    "hot-reload",
    "developer-tools"
  ],
  "contributes": {
    "commands": [
      {
        "command": "flutterAirRun.doctor",
        "title": "Doctor",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.devices",
        "title": "Devices",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.wirelessStatus",
        "title": "Wireless Status",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.pairDevice",
        "title": "Pair Device with Code",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.runWireless",
        "title": "Run on Wireless Device",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.helperDoctor",
        "title": "QR Generator Doctor",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.qrSessionPreview",
        "title": "Preview QR Pairing Session",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.pairDeviceWithQr",
        "title": "Pair Device with QR Code",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.refreshActions",
        "title": "Refresh AirRun Actions",
        "category": "Flutter AirRun",
        "icon": "$(refresh)"
      },
      {
        "command": "flutterAirRun.openCli",
        "title": "Open AirRun CLI — Recommended",
        "category": "Flutter AirRun",
        "icon": "$(terminal)"
      },
      {
        "command": "flutterAirRun.installCli",
        "title": "Install AirRun CLI",
        "category": "Flutter AirRun",
        "icon": "$(cloud-download)"
      },
      {
        "command": "flutterAirRun.checkCli",
        "title": "Check AirRun CLI",
        "category": "Flutter AirRun",
        "icon": "$(check)"
      },
      {
        "command": "flutterAirRun.updateCli",
        "title": "Update AirRun CLI",
        "category": "Flutter AirRun",
        "icon": "$(sync)"
      },
      {
        "command": "flutterAirRun.uninstallCli",
        "title": "Uninstall AirRun CLI",
        "category": "Flutter AirRun",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flutterAirRun",
          "title": "Flutter AirRun",
          "icon": "resources/airrun.svg"
        }
      ]
    },
    "views": {
      "flutterAirRun": [
        {
          "id": "flutterAirRun.actions",
          "name": "Actions",
          "contextualTitle": "Flutter AirRun",
          "icon": "resources/airrun.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "flutterAirRun.refreshActions",
          "when": "view == flutterAirRun.actions",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm --filter @flutter-airrun/core build && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "pnpm --filter @flutter-airrun/core build && tsc --noEmit",
    "clean": "rm -rf dist",
    "package:prepare": "node scripts/prepare-package.mjs",
    "vscode:prepublish": "pnpm run build && pnpm run package:prepare",
    "package:vsix": "node scripts/package-vsix.mjs",
    "package:list": "vsce ls --no-dependencies"
  },
  "dependencies": {
    "@flutter-airrun/core": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "author": {
    "name": "Henry GOSSOU",
    "url": "https://github.com/Hen17Ry"
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "#071127",
    "theme": "dark"
  },
  "icon": "resources/icon.png",
  "main": "./dist/extension.js"
}
