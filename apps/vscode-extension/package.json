{
  "name": "flutter-airrun",
  "displayName": "Flutter AirRun",
  "description": "Run Flutter applications on Android devices over wireless ADB.",
  "version": "0.1.0",
  "publisher": "flutter-airrun",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "flutter",
    "android",
    "adb",
    "wireless",
    "device"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flutterAirRun.hello",
        "title": "Hello",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.doctor",
        "title": "Doctor",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.devices",
        "title": "Devices",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.wirelessStatus",
        "title": "Wireless Status",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.pairDevice",
        "title": "Pair Device with Code",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.runWireless",
        "title": "Run on Wireless Device",
        "category": "Flutter AirRun"
      }
    ]
  },
  "scripts": {
    "build": "pnpm --filter @flutter-airrun/core build && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "pnpm --filter @flutter-airrun/core build && tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flutter-airrun/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "1.100.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "activationEvents": [
    
  ]
}
