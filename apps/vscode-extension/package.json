{
  "name": "flutter-airrun",
  "displayName": "Flutter AirRun",
  "description": "Connect, pair and run Flutter applications on Android devices wirelessly.",
  "version": "0.1.0",
  "publisher": "flutter-airrun",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "flutter",
    "android",
    "adb",
    "wireless",
    "debugging",
    "qr-code",
    "developer-tools"
  ],
  "activationEvents": [
    "onCommand:flutterAirRun.hello",
    "onView:flutterAirRun"
  ],
  "contributes": {
    "commands": [
      {
        "command": "flutterAirRun.doctor",
        "title": "Doctor",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.devices",
        "title": "Devices",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.wirelessStatus",
        "title": "Wireless Status",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.pairDevice",
        "title": "Pair Device with Code",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.runWireless",
        "title": "Run on Wireless Device",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.helperDoctor",
        "title": "QR Helper Doctor",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.qrSessionPreview",
        "title": "Preview QR Pairing Session",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.pairDeviceWithQr",
        "title": "Pair Device with QR Code",
        "category": "Flutter AirRun"
      },
      {
        "command": "flutterAirRun.refreshActions",
        "title": "Refresh AirRun Actions",
        "category": "Flutter AirRun",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Flutter AirRun",
      "properties": {
        "flutterAirRun.helperPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to the Flutter AirRun native QR pairing helper."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flutterAirRun",
          "title": "Flutter AirRun",
          "icon": "resources/airrun.svg"
        }
      ]
    },
    "views": {
      "flutterAirRun": [
        {
          "id": "flutterAirRun.actions",
          "name": "Actions",
          "contextualTitle": "Flutter AirRun",
          "icon": "resources/airrun.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "flutterAirRun.refreshActions",
          "when": "view == flutterAirRun.actions",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm --filter @flutter-airrun/core build && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "pnpm --filter @flutter-airrun/core build && tsc --noEmit",
    "clean": "rm -rf dist",
    "package:prepare": "node scripts/prepare-package.mjs",
    "vscode:prepublish": "pnpm run build && pnpm run package:prepare",
    "package:vsix": "mkdir -p ../../artifacts && vsce package --target linux-x64 --no-dependencies --out ../../artifacts/flutter-airrun-${npm_package_version}-linux-x64.vsix",
    "package:list": "vsce ls --no-dependencies"
  },
  "dependencies": {
    "@flutter-airrun/core": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "author": {
    "name": "Henry GOSSOU",
    "url": "https://github.com/Hen17Ry"
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "#071127",
    "theme": "dark"
  },
  "icon": "resources/icon.png"
}
